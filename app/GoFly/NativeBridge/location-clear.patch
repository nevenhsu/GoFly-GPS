+//! GoFly: clear location simulation through the CoreDevice location service.
+
+use std::ptr::null_mut;
+use std::time::Duration;
+
+use idevice::core_device::LocationServiceClient;
+use idevice::{IdeviceError, RsdService as _};
+
+use crate::{IdeviceFfiError, core_device_proxy::AdapterHandle, ffi_err, rsd::RsdHandshakeHandle, run_sync_local};
+
+/// Clears any active location simulation through
+/// `com.apple.coredevice.locationservice`. One snapshot of the global timeout
+/// covers connecting and the reply.
+///
+/// # Safety
+/// `provider` and `handshake` must be valid handles from this library.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn gofly_coredevice_location_clear(
+    provider: *mut AdapterHandle,
+    handshake: *mut RsdHandshakeHandle,
+) -> *mut IdeviceFfiError {
+    if provider.is_null() || handshake.is_null() {
+        return ffi_err!(IdeviceError::FfiInvalidArg);
+    }
+    let timeout = Duration::from_secs(crate::GLOBAL_TIMEOUT.load(std::sync::atomic::Ordering::Relaxed));
+    let res: Result<(), IdeviceError> = run_sync_local(async move {
+        let provider_ref = unsafe { &mut (*provider).0 };
+        let handshake_ref = unsafe { &mut (*handshake).0 };
+        tokio::time::timeout(timeout, async {
+            let mut client = LocationServiceClient::connect_rsd(provider_ref, handshake_ref).await?;
+            client.clear_simulated_location().await
+        })
+        .await
+        .unwrap_or(Err(IdeviceError::Timeout))
+    });
+    match res {
+        Ok(()) => null_mut(),
+        Err(e) => ffi_err!(e),
+    }
+}
